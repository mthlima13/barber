# ---- API (Spring Boot) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/barberflow
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=change-me-local-only
SERVER_PORT=8080

APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
BARBERSHOP_DEFAULT_TIMEZONE=America/Sao_Paulo

# ---- Auth (JWT HS256, minimo 32 bytes; troque em producao) ----
AUTH_JWT_SECRET=dev-secret-change-me-32-bytes-minimum!!
AUTH_JWT_TTL_MINUTES=720

# ---- WhatsApp (desabilitado no MVP ate credenciais reais) ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_POLL_INTERVAL_MILLIS=15000

# ---- Lista de espera ----
WAITLIST_OFFER_TTL_MINUTES=5

# ---- Privacidade (LGPD) ----
PRIVACY_POLICY_VERSION=1.0
PRIVACY_RETENTION_ENABLED=false
PRIVACY_RETENTION_MONTHS=24
PRIVACY_RETENTION_CRON=0 0 3 * * *

# ---- Rate limit (por IP, janela de 60s) ----
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=60
RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Barbearia padrao do MVP de instancia unica (redireciona / -> /b/{slug})
NEXT_PUBLIC_DEFAULT_SLUG=barbearia-piloto
