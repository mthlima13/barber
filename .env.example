# ---- API (Spring Boot) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/barberflow
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=change-me-local-only
SERVER_PORT=8080

APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
BARBERSHOP_DEFAULT_TIMEZONE=America/Sao_Paulo

# ---- Auth (JWT HS256, minimo 32 bytes; troque em producao) ----
AUTH_JWT_SECRET=dev-secret-change-me-32-bytes-minimum!!
AUTH_JWT_TTL_MINUTES=720

# ---- WhatsApp (desabilitado no MVP ate a Fase 4) ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- Lista de espera ----
WAITLIST_OFFER_TTL_MINUTES=5

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
